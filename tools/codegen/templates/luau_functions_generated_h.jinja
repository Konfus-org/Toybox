#pragma once
// AUTO-GENERATED by tools/codegen from [[tbx::exposed_to_scripting]] free functions — DO NOT EDIT.
// Included by the Luau backend AFTER luau_marshal.h and the headers that declare the bound functions.
// Each install_generated_<module>() leaves a new table of that module's exposed free functions on the
// Lua stack; the marshalling is done generically by bind<> — no per-function stack code.
namespace tbx
{
{% for module in modules %}
    inline void install_generated_{{ module.name }}(lua_State* lua)
    {
        const luaL_Reg functions[] = {
{% for function in module.functions %}
            {"{{ function.lua_name }}", bind<&{{ function.cpp_name }}>},
{% endfor %}
            {nullptr, nullptr}};
        lua_createtable(lua, 0, {{ module.functions | length }});
        luaL_register(lua, nullptr, functions);
    }
{% endfor %}
}
