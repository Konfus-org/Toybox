#include "ShaderBase.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint instance_id = gl_GlobalInvocationID.x;
    if (instance_id >= totalInstanceCount)
    {
        return;
    }

    InstanceData instance = instances[instance_id];
    if (currentPassFilter == TBX_SHADER_PIPELINE_FLAG_SHADOW)
    {
        for (uint light_id = 0u; light_id < lightCount; ++light_id)
        {
            if (lights[light_id].shadowData.x < 0.0)
            {
                continue;
            }

            uint shadow_slot = atomicAdd(shadowDrawCount, 1u);
            if (shadow_slot >= maxShadowDrawCount)
            {
                continue;
            }

            uint encoded_base_instance = (light_id * max(totalInstanceCount, 1u)) + instance_id;
            tbx_write_draw_command(shadow_slot, instance_id, encoded_base_instance, true);
        }

        return;
    }

    if (!tbx_aabb_is_inside_frustum(instance.boundsMin.xyz, instance.boundsMax.xyz))
    {
        return;
    }

    uint scene_slot = atomicAdd(mainSceneDrawCount, 1u);
    if (scene_slot < maxSceneDrawCount)
    {
        tbx_write_draw_command(scene_slot, instance_id, instance_id, false);
    }
}
